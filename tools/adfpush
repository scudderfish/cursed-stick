#!/usr/bin/env bash
# adfpush — push ADF/ADZ files from a PC to the Cursed WiFi stick.
#
#   adfpush Games/Lemmings.adf
#   adfpush ~/amiga/adfs/            # all *.adf/*.adz in a directory
#   CURSED_HOST=192.168.1.50 adfpush file.adz
#
# Tip: compress to .adz first — FlashFloppy reads them natively and you fit
# ~2-4x more on the stick:
#   gzip -9k Lemmings.adf && adfpush Lemmings.adz
set -euo pipefail

HOST="${CURSED_HOST:-cursed.local}"

if [ "$#" -lt 1 ]; then
  echo "usage: adfpush FILE [FILE...]" >&2
  echo "   or: adfpush DIR       (uploads *.adf and *.adz in DIR)" >&2
  exit 2
fi

push() {
  local f="$1"
  printf '-> %s\n' "$f"
  curl --fail --silent --show-error -F "file=@${f}" "http://${HOST}/upload" && echo
}

for arg in "$@"; do
  if [ -d "$arg" ]; then
    find "$arg" -maxdepth 1 -type f \( -iname '*.adf' -o -iname '*.adz' \) -print0 |
      while IFS= read -r -d '' f; do push "$f"; done
  else
    push "$arg"
  fi
done
